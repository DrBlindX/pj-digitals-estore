{
  "expo": {
    "userInterfaceStyle": "light",
    "scheme": "tdpstore-partner",
    "web": {
      "favicon": "../shared/assets/nearby-logo.png"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "../shared/assets/nearby-logo.png"
    },
    "orientation": "portrait",
    "icon": "../shared/assets/nearby-logo.png",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NearBy Shop to select product photos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@clerk/expo-native-components/app.plugin.js",
      "./mobile-build.cjs"
    ],
    "slug": "tdpstore-shop",
    "version": "1.0.0",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F7FA",
        "foregroundImage": "../shared/assets/nearby-logo.png"
      },
      "package": "com.nearby.shop",
      "versionCode": 4
    },
    "name": "NearBy Shop"
  }
}
