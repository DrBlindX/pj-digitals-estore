{
  "expo": {
    "name": "NearBy",
    "slug": "client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../shared/assets/nearby-logo.png",
    "scheme": "client",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "../shared/assets/nearby-logo.png"
    },
    "android": {
      "package": "com.nearby.customer",
      "adaptiveIcon": {
        "backgroundColor": "#F5F7FA",
        "foregroundImage": "../shared/assets/nearby-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "../shared/assets/nearby-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      "@clerk/expo-native-components/app.plugin.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7FA",
          "image": "../shared/assets/nearby-logo.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
